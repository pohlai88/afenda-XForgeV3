# Copy to .env.local and fill in. Never commit a filled-in copy.
#
# You may not need to: compose.yaml provisions the fixture these URLs already
# default to, so `docker compose up -d` is enough to run the suite on a clean
# checkout. Fill this in only to point somewhere else.
#
# The local Docker fixture credential lives in packages/db/bootstrap.sql and is
# deliberately NOT repeated here: a working shared secret in a committed file is
# how a local fixture becomes a production credential. CI injects its own;
# preview and production use managed secrets.

# Owner connection -- migrations and provisioning only.
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:55432/xforge

# Application connection. MUST be a non-owner role without BYPASSRLS (ADR-003):
# RLS is silently skipped for owners and superusers.
APP_DATABASE_URL=postgres://app_user:CHANGE_ME@127.0.0.1:55432/xforge

# Turns on the development principal. There is NO default: absent this, the API
# has no principal and refuses every request. Real authentication arrives with
# the identity phase. Never set this in a deployed environment.
XFORGE_DEV_PRINCIPAL=enabled

# The tenant the development principal is scoped to. NO DEFAULT: the composition
# root used to fall back to the fixture tenant, and a fixture compiled into the
# application is no longer a fixture. Local development uses the tenant
# packages/db/bootstrap.sql provisions.
DEV_TENANT_ID=11111111-1111-4111-8111-111111111111

# Raises which phases the gate treats as started. Blocked stages in a started
# phase fail `pnpm verify:ci`.
XFORGE_PHASE=spine
