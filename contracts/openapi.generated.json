{
  "info": {
    "description": "Multi-tenant HRMS and payroll platform. Every operation declares a policy; see .architecture/adr/ADR-014-policy-declaration.md.",
    "title": "Xforge API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "description": "production",
      "url": "https://api.xforge.app"
    }
  ],
  "components": {
    "schemas": {
      "EmergencyContact": {
        "type": "object",
        "properties": {
          "employeeId": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "phone": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "relationship": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "employeeId",
          "id",
          "name",
          "phone",
          "relationship",
          "version"
        ]
      },
      "Completeness": {
        "type": "object",
        "properties": {
          "completeness": {
            "type": "string",
            "enum": [
              "complete",
              "partial"
            ]
          },
          "partialReasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartialReason"
            }
          }
        },
        "required": [
          "completeness"
        ],
        "additionalProperties": false
      },
      "PartialReason": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "result_cap"
            ]
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "returned": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "code",
          "limit",
          "returned"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "detail",
          "status",
          "title",
          "type"
        ]
      },
      "NewEmergencyContact": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "phone": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "relationship": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "name",
          "phone",
          "relationship"
        ]
      },
      "UpdateEmergencyContact": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "phone": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "relationship": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "version"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/employees/{employeeId}/emergency-contacts": {
      "get": {
        "operationId": "listEmergencyContacts",
        "summary": "List an employee emergency contacts",
        "tags": [
          "HR"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "employeeId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The contacts, and whether this is all of them",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EmergencyContact"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Completeness"
                    }
                  },
                  "required": [
                    "items",
                    "meta"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createEmergencyContact",
        "summary": "Add an emergency contact",
        "tags": [
          "HR"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "employeeId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEmergencyContact"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyContact"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/emergency-contacts/{id}": {
      "patch": {
        "operationId": "updateEmergencyContact",
        "summary": "Update an emergency contact",
        "tags": [
          "HR"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEmergencyContact"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyContact"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Version conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
