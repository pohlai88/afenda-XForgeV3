{
  "name": "@xforge/design",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "imports": {
    "#generated/*": "./generated/*.ts",
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
