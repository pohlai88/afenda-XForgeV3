    "./components/ui/*": null,
    "./policy": "./policy/index.mjs",
    "./style-manifest.json": "./generated/style-manifest.json",
    "./tailwind-theme.css": "./generated/tailwind-theme.css",
    "./tokens.css": "./generated/tokens.css",
    "./tokens.json": "./policy/tokens.json"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@shadcn/react": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "date-fns": "catalog:",
    "embla-carousel-react": "catalog:",
    "input-otp": "catalog:",
    "lucide-react": "^1.38.0",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "tailwindcss": "catalog:",
    "vitest": "catalog:"
  }
}
