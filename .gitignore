node_modules/
dist/
build/
.next/
.turbo/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example


# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Storybook
storybook-static/

# Plan documents. Personal working notes, not repository artefacts.
.human-plans-file/

# Claude Code personal overrides (project settings.json IS committed)
.claude/settings.local.json

# EnterWorktree checks out linked worktrees under here. Unignored, a single
# `git add -A` in the main checkout commits an entire second copy of the tree.
.claude/worktrees/

# Storybook's build output. `storybook build` writes it into the checkout, and a run
# that leaves the tree dirty is the thing law 33 exists to prevent.
storybook-static/

# Downloaded UI reference material and the notes written about it. Personal
# working notes, not repository artefacts -- same category as .human-plans-file.
# ~11k lines of third-party docs (Base UI, Prototyper, Fragments); vendoring them
# would put someone else's documentation under this repository's review rules.
.claude/llmx/

# Written by Next, and its content depends on whether dev or build ran last.
# Tracking it guarantees a dirty tree. apps/web/types/assets.d.ts owns the
# declarations this application actually needs.
next-env.d.ts

tests/harness/dist/

# Vitest browser mode writes failure screenshots into the checkout; a red run must
# not change the tree (law 33). screenshotFailures is off in vitest.config.ts and
# these paths are ignored in case a future provider writes them anyway.
.vitest-attachments/
**/__screenshots__/
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/compiled/
