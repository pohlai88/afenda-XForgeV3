{
  "name": "xforge",
  "private": true,
  "type": "module",
  "scripts": {
    "build:harness": "vite build --config vite.harness.config.ts",
    "check": "biome ci .",
    "e2e": "playwright test",
    "e2e:port": "node tooling/e2e/preflight-port.mjs",
    "fix": "ultracite fix",
    "gen:client": "orval --config orval.config.ts",
    "gen:openapi": "tsx tooling/generate/emit-openapi.ts",
    "gen:tokens": "node tooling/generators/tokens.mjs",
    "gen:ui-schema": "tsx tooling/generate/emit-ui-schema.ts",
    "generate": "pnpm -s gen:tokens && pnpm -s gen:ui-schema && pnpm -s gen:openapi && pnpm -s gen:client",
    "guards": "node tooling/architecture/run-guards.mjs",
    "guards:mutate": "node tooling/architecture/run-guards.mjs --mutation-test",
    "perf:budgets": "node tooling/perf/check-budgets.mjs",
    "perf:measure": "node tooling/perf/route-bundle-size.mjs",
    "test:architecture:tenancy": "vitest run --project architecture",
    "test:integration": "vitest run --project integration --reporter=dot",
    "verify": "node tooling/verify/verify.mjs",
    "verify:ci": "node tooling/verify/verify.mjs --ci",
    "verify:coverage": "node tooling/verify/verify.mjs --coverage",
    "verify:fast": "node tooling/verify/verify.mjs --fast",
    "verify:list": "node tooling/verify/verify.mjs --list"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@xforge/api": "workspace:*",
    "@xforge/api-client": "workspace:*",
    "@xforge/db": "workspace:*",
    "@xforge/fixtures": "workspace:*",
    "@xforge/hr": "workspace:*",
    "@xforge/policy": "workspace:*",
    "@xforge/tenancy": "workspace:*",
    "@xforge/ui": "workspace:*",
    "ajv": "8.20.0",
    "drizzle-kit": "^0.31.10",
    "msw": "catalog:",
    "orval": "^8.27.0",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7",
    "vite": "^7.0.0",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  }
}
