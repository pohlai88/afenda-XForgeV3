{
  "name": "xforge",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "biome ci .",
    "db:migrate": "node tooling/db/migrate.mjs",
    "e2e": "playwright test",
    "e2e:port": "node tooling/e2e/preflight-port.mjs",
    "fix": "ultracite fix",
    "gen:client": "orval --config orval.config.ts",
    "gen:openapi": "tsx tooling/generate/emit-openapi.ts",
    "gen:tokens": "node packages/design/policy/generators/tokens.mjs",
    "generate": "pnpm -s gen:tokens && pnpm -s gen:openapi && pnpm -s gen:client",
    "test:architecture:tenancy": "vitest run --project architecture",
    "test:integration": "vitest run --project integration --reporter=dot"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "2.5.11",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser-playwright": "catalog:",
    "@xforge/api": "workspace:*",
    "@xforge/api-client": "workspace:*",
    "@xforge/db": "workspace:*",
    "@xforge/design": "workspace:*",
    "@xforge/fixtures": "workspace:*",
    "@xforge/hr": "workspace:*",
    "@xforge/policy": "workspace:*",
    "@xforge/tenancy": "workspace:*",
    "ajv": "8.20.0",
    "drizzle-kit": "^0.31.10",
    "msw": "catalog:",
    "orval": "^8.27.0",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7",
    "vite": "^7.0.0",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  }
}
