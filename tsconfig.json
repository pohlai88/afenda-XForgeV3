{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "modules/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "tooling/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/.next",
    "**/dist",
    "packages/design/src/components/ui"
  ]
}
